prepare_te_bed() {
  local te_input=$1
  local temp_dir=$2

  mkdir -p "$temp_dir"

  python3 - "$te_input" "$temp_dir" <<'PYTHON_HELPER'
import csv
import os
import sys

te_input, temp_dir = sys.argv[1:3]
out_path = os.path.join(temp_dir, "TE.bed")

def is_int(value):
    try:
        int(value)
        return True
    except ValueError:
        return False

rows = []
mode = None

with open(te_input, "r", encoding="utf-8") as handle:
    reader = csv.reader(handle, delimiter="\t")
    for row in reader:
        if not row or all(not cell.strip() for cell in row):
            continue
        rows.append(row)
        if mode is None:
            if len(row) >= 6 and is_int(row[1]) and is_int(row[2]):
                mode = "bed"
            elif len(row) >= 6 and is_int(row[2]) and is_int(row[3]):
                mode = "annotation"
            else:
                raise SystemExit(
                    "unsupported TE input format. Expected BED (chr,start,end,name,score,strand) "
                    "or annotation table (name,chr,start,end,score,strand,...)"
                )

if not rows:
    raise SystemExit("TE input file is empty")

with open(out_path, "w", encoding="utf-8", newline="") as out_handle:
    writer = csv.writer(out_handle, delimiter="\t", lineterminator="\n")
    for row in rows:
        if mode == "bed":
            writer.writerow(row[:6])
        else:
            writer.writerow([row[1], row[2], row[3], row[0], row[4], row[5]])

print(out_path)
PYTHON_HELPER
}

normalize_seqname_files() {
  local reference_file=$1
  local reference_kind=$2
  local output_dir=$3
  shift 3

  mkdir -p "$output_dir"

  python3 - "$reference_file" "$reference_kind" "$output_dir" "$@" <<'PYTHON_HELPER'
import csv
import gzip
import os
import sys

reference_file = sys.argv[1]
reference_kind = sys.argv[2]
output_dir = sys.argv[3]
targets = sys.argv[4:]

if not targets:
    raise SystemExit("no target files provided for seqname normalization")

def canonical_key(name):
    value = name.strip()
    lowered = value.lower()
    if lowered.startswith("chromosome"):
        lowered = lowered[len("chromosome"):]
    if lowered.startswith("chr"):
        lowered = lowered[3:]
    if lowered in {"m", "mt", "mitochondria", "mitochondrion"}:
        return "mt"
    if lowered in {"c", "pt", "plastid", "chloroplast"}:
        return "pt"
    return lowered

def read_reference_names(path, kind):
    names = []
    with open(path, "r", encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            row = line.rstrip("\n").split("\t")
            if kind == "fai":
                names.append(row[0])
            elif kind == "bed":
                if len(row) >= 1:
                    names.append(row[0])
            else:
                raise SystemExit(f"unsupported reference kind: {kind}")
    return names

reference_names = read_reference_names(reference_file, reference_kind)
if not reference_names:
    raise SystemExit(f"no chromosome names found in reference file: {reference_file}")

reference_by_exact = {name: name for name in reference_names}
reference_by_key = {}
ambiguous_keys = set()
for name in reference_names:
    key = canonical_key(name)
    if key in reference_by_key and reference_by_key[key] != name:
        ambiguous_keys.add(key)
    else:
        reference_by_key[key] = name

for key in ambiguous_keys:
    reference_by_key.pop(key, None)

def map_name(name):
    if name in reference_by_exact:
        return name
    key = canonical_key(name)
    if key in reference_by_key:
        return reference_by_key[key]
    raise SystemExit(
        f"unmatched chromosome name '{name}' while normalizing against {reference_file}"
    )

def normalize_tabular_file(src, dst, seq_col, delimiter="\t", gzip_mode=False):
    opener = gzip.open if gzip_mode else open
    mode = "rt" if gzip_mode else "r"
    write_mode = "wt" if gzip_mode else "w"
    with opener(src, mode, encoding="utf-8") as infile, open(dst, "w", encoding="utf-8", newline="") as outfile:
        reader = csv.reader(infile, delimiter=delimiter)
        writer = csv.writer(outfile, delimiter=delimiter, lineterminator="\n")
        for row in reader:
            if not row:
                continue
            row[seq_col] = map_name(row[seq_col])
            writer.writerow(row)

for target in targets:
    src_path, file_kind = target.split("::", 1)
    base_name = os.path.basename(src_path)
    dst_path = os.path.join(output_dir, base_name)

    if file_kind == "bed":
        normalize_tabular_file(src_path, dst_path, 0)
    elif file_kind == "gff":
        with open(src_path, "r", encoding="utf-8") as infile, open(dst_path, "w", encoding="utf-8", newline="") as outfile:
            for line in infile:
                if not line.strip() or line.startswith("#"):
                    outfile.write(line)
                    continue
                row = line.rstrip("\n").split("\t")
                row[0] = map_name(row[0])
                outfile.write("\t".join(row) + "\n")
    elif file_kind == "cgmap":
        with gzip.open(src_path, "rt", encoding="utf-8") as infile, gzip.open(dst_path, "wt", encoding="utf-8", newline="") as outfile:
            reader = csv.reader(infile, delimiter="\t")
            writer = csv.writer(outfile, delimiter="\t", lineterminator="\n")
            for row in reader:
                if not row:
                    continue
                row[0] = map_name(row[0])
                writer.writerow(row)
    else:
        raise SystemExit(f"unsupported target kind: {file_kind}")

    print(f"{src_path}\t{dst_path}")
PYTHON_HELPER
}

generate_promoter_bed() {
  local gene_bed=$1
  local fai=$2
  local promoter_bed=$3
  local up_bp=${4:-1500}
  local down_bp=${5:-500}

  python3 - "$gene_bed" "$fai" "$promoter_bed" "$up_bp" "$down_bp" <<'PYTHON_HELPER'
import csv
import sys

gene_bed_path, fai_path, promoter_bed_path, up_bp, down_bp = sys.argv[1:6]
up_bp = int(up_bp)
down_bp = int(down_bp)

chrom_sizes = {}
with open(fai_path, "r", encoding="utf-8") as handle:
    for line in handle:
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 2:
            chrom_sizes[parts[0]] = int(parts[1])

with open(gene_bed_path, "r", encoding="utf-8") as infile, open(promoter_bed_path, "w", encoding="utf-8", newline="") as outfile:
    reader = csv.reader(infile, delimiter="\t")
    writer = csv.writer(outfile, delimiter="\t", lineterminator="\n")
    for row in reader:
        if len(row) < 6:
            continue
        chrom = row[0]
        if chrom not in chrom_sizes:
            continue
        start = int(row[1])
        end = int(row[2])
        name = row[3]
        score = row[4] if row[4] else "0"
        strand = row[5]
        if strand == "+":
            promoter_start = max(0, start - up_bp)
            promoter_end = min(chrom_sizes[chrom], start + down_bp)
        else:
            promoter_start = max(0, end - down_bp)
            promoter_end = min(chrom_sizes[chrom], end + up_bp)
        if promoter_start >= promoter_end:
            continue
        writer.writerow([chrom, promoter_start, promoter_end, name, score, strand])
PYTHON_HELPER
}

run_module_0() {
  local gff_file=""
  local te_bed=""
  local gene_exp=""
  local te_exp=""
  local deg_file=""
  local dete_file=""
  local de_source=""
  local fai=""
  local outdir=""
  local original_te_input=""
  local up_bp=1500
  local down_bp=500
  local -a meth_files=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -g) gff_file=$2; shift 2 ;;
      -t) te_bed=$2; shift 2 ;;
      -eg) gene_exp=$2; shift 2 ;;
      -et) te_exp=$2; shift 2 ;;
      -DEG|--DEG) deg_file=$2; shift 2 ;;
      -DETE|--DETE) dete_file=$2; shift 2 ;;
      -f|-fai) fai=$2; shift 2 ;;
      -o) outdir=$2; shift 2 ;;
      -up) up_bp=$2; shift 2 ;;
      -dn) down_bp=$2; shift 2 ;;
      -m)
        shift
        while [[ $# -gt 0 && ! $1 =~ ^- ]]; do
          meth_files+=("$1")
          shift
        done
        ;;
      -h|--help) usage ;;
      *) die "unknown option for module 0: $1" ;;
    esac
  done

  CURRENT_STEP="argument validation"
  [[ -n $gff_file ]] || die "missing required argument: -g annotation.gff3"
  [[ -n $te_bed ]] || die "missing required argument: -t TE.bed_or_TE.txt"
  [[ -n $gene_exp ]] || die "missing required argument: -eg gene_expression.txt"
  [[ -n $te_exp ]] || die "missing required argument: -et TE_expression.txt"
  [[ -n $fai ]] || die "missing required argument: -f genome.fa.fai"
  (( ${#meth_files[@]} > 0 )) || die "missing required argument: -m sample1.CGmap.gz [sample2.CGmap.gz ...]"

  gff_file=$(resolve_path "$gff_file")
  te_bed=$(resolve_path "$te_bed")
  original_te_input=$te_bed
  gene_exp=$(resolve_path "$gene_exp")
  te_exp=$(resolve_path "$te_exp")
  if [[ -n $deg_file || -n $dete_file ]]; then
    [[ -n $deg_file && -n $dete_file ]] || die "-DEG and -DETE must be provided together"
    deg_file=$(resolve_path "$deg_file")
    dete_file=$(resolve_path "$dete_file")
  fi
  fai=$(resolve_path "$fai")
  outdir=$(resolve_path "${outdir:-$(pwd)}")

  require_file "GFF annotation file" "$gff_file"
  require_file "TE input file" "$te_bed"
  require_file "Gene expression file" "$gene_exp"
  require_file "TE expression file" "$te_exp"
  [[ -n $deg_file ]] && require_file "DEG file" "$deg_file"
  [[ -n $dete_file ]] && require_file "DETE file" "$dete_file"
  require_file "FAI file" "$fai"

  local i
  for ((i = 0; i < ${#meth_files[@]}; i++)); do
    meth_files[$i]=$(resolve_path "${meth_files[$i]}")
    require_file "Methylation file" "${meth_files[$i]}"
  done

  mkdir -p "$outdir"
  local deg_out="$outdir/DEG.txt"
  local dete_out="$outdir/DETE.txt"
  CURRENT_STEP="DEG/DETE preparation"
  if [[ -n $deg_file ]]; then
    [[ $deg_file == "$deg_out" ]] || cp "$deg_file" "$deg_out"
    [[ $dete_file == "$dete_out" ]] || cp "$dete_file" "$dete_out"
    de_source="provided"
  else
    (
      cd "$outdir"
      Rscript "$SCRIPT_DIR/edgeR_for_expression.R" --eg "$gene_exp" --et "$te_exp" --outdir "$outdir"
    )
    [[ -f $deg_out || ! -f $outdir/PleosPC15_DEG.txt ]] || cp "$outdir/PleosPC15_DEG.txt" "$deg_out"
    [[ -f $dete_out || ! -f $outdir/PleosPC15_DETE.txt ]] || cp "$outdir/PleosPC15_DETE.txt" "$dete_out"
    require_file "generated DEG file" "$deg_out"
    require_file "generated DETE file" "$dete_out"
    de_source="$SCRIPT_DIR/edgeR_for_expression.R"
  fi
  deg_file="$deg_out"
  dete_file="$dete_out"

  te_bed=$(prepare_te_bed "$te_bed" "$outdir/tmp/module_0_te_input")
  local normalized_root="$outdir/tmp/module_0_normalized"
  mkdir -p "$normalized_root"

  CURRENT_STEP="seqname normalization"
  local normalized_output
  normalized_output=$(
    normalize_seqname_files "$fai" "fai" "$normalized_root" \
      "${gff_file}::gff" \
      "${te_bed}::bed"
  )
  mapfile -t normalized_paths <<< "$normalized_output"

  local mapped_src mapped_dst
  for item in "${normalized_paths[@]}"; do
    mapped_src=${item%%$'\t'*}
    mapped_dst=${item#*$'\t'}
    if [[ $mapped_src == "$gff_file" ]]; then
      gff_file=$mapped_dst
    elif [[ $mapped_src == "$te_bed" ]]; then
      te_bed=$mapped_dst
    else
      for ((i = 0; i < ${#meth_files[@]}; i++)); do
        if [[ ${meth_files[$i]} == "$mapped_src" ]]; then
          meth_files[$i]=$mapped_dst
          break
        fi
      done
    fi
  done

  local temp_root="$outdir/tmp/module_0_annotation"
  mkdir -p "$temp_root"

  local gene_bed="$temp_root/gene.bed"
  local promoter_bed="$temp_root/promoter.bed"

  CURRENT_STEP="annotation conversion"
  Rscript "$SCRIPT_DIR/gff_to_bed.R" --gff "$gff_file" --outdir "$temp_root" --protein-coding-only y
  generate_promoter_bed "$gene_bed" "$fai" "$promoter_bed" "$up_bp" "$down_bp"
  require_file "generated gene BED file" "$gene_bed"
  require_file "generated promoter BED file" "$promoter_bed"

  CURRENT_STEP="module 0 execution"
  (
    cd "$outdir"
    bash "$SCRIPT_DIR/0_preprocessing.sh" \
      -g "$gene_bed" \
      -t "$te_bed" \
      -p "$promoter_bed" \
      -eg "$gene_exp" \
      -et "$te_exp" \
      -fai "$fai" \
      -m "${meth_files[@]}"
  )
  CURRENT_STEP="write manifest"
  write_module0_manifest \
    "$outdir/PETEM_MODULE0_MANIFEST.json" \
    "$outdir" \
    "$gff_file" \
    "$original_te_input" \
	    "$te_bed" \
	    "$gene_exp" \
	    "$te_exp" \
	    "$deg_file" \
	    "$dete_file" \
	    "$de_source" \
	    "$fai" \
    "$up_bp" \
    "$down_bp" \
    "$temp_root" \
    "${meth_files[@]}"
}

run_module_1() {
  local genome_dir=""
  local te_bed=""
  local fai=""
  local outdir=""
  local manifest=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -g) genome_dir=$2; shift 2 ;;
      -t) te_bed=$2; shift 2 ;;
      -f) fai=$2; shift 2 ;;
      --manifest) manifest=$2; shift 2 ;;
      -o) outdir=$2; shift 2 ;;
      -h|--help) usage ;;
      *) die "unknown option for module 1: $1" ;;
    esac
  done

  CURRENT_STEP="argument validation"
  if [[ -n $manifest ]]; then
    manifest=$(resolve_path "$manifest")
    require_file "module 0 manifest file" "$manifest"
    [[ -n $genome_dir ]] || genome_dir=$(manifest_get "$manifest" "outputs.annotation_dir" || true)
    [[ -n $te_bed ]] || te_bed=$(manifest_get "$manifest" "inputs.te_input_original" || true)
    [[ -n $fai ]] || fai=$(manifest_get "$manifest" "inputs.fai" || true)
  fi

  [[ -n $genome_dir ]] || die "missing required argument: -g genome_bed_dir or --manifest module0_manifest.json"
  [[ -n $te_bed ]] || die "missing required argument: -t TE.bed_or_TE.txt or --manifest module0_manifest.json"
  [[ -n $fai ]] || die "missing required argument: -f genome.fa.fai or --manifest module0_manifest.json"

  genome_dir=$(resolve_path "$genome_dir")
  te_bed=$(resolve_path "$te_bed")
  fai=$(resolve_path "$fai")
  outdir=$(resolve_path "${outdir:-$(pwd)}")

  [[ -d $genome_dir ]] || die "genome BED directory not found: $genome_dir"
  require_file "TE input file" "$te_bed"
  require_file "FAI file" "$fai"

  local gene_bed="$genome_dir/gene.bed"
  local cds_bed="$genome_dir/CDS.bed"
  local exon_bed="$genome_dir/exon.bed"
  local utr5_bed="$genome_dir/UTR5.bed"
  local utr3_bed="$genome_dir/UTR3.bed"
  local promoter_bed="$genome_dir/promoter.bed"

  require_file "gene BED file" "$gene_bed"
  require_file "CDS BED file" "$cds_bed"
  require_file "exon BED file" "$exon_bed"
