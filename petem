main() {
  [[ $# -gt 0 ]] || usage

  local command=$1
  shift

  case "$command" in
    --0|0|0_preprocessing)
      run_module_0 "$@"
      ;;
    --1|1|1_TE_distribution)
      run_module_1 "$@"
      ;;
    --2|2|2_TE_families)
      run_module_2 "$@"
      ;;
    --3|3|3_TE_impact_distance)
      run_module_3 "$@"
      ;;
    --4|4|4_single_condition_correlation)
      run_module_4 "$@"
      ;;
    --5|5|5_cross_condition_correlation)
      run_module_5 "$@"
      ;;
    -h|--help)
      usage
      ;;
    *)
      die "unsupported command: ${command}"
      ;;
  esac
}

main "$@"
