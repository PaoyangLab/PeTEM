  require_file "DETE file" "$dete_file"
  [[ -d $module0_dir ]] || die "module 0 output directory not found: $module0_dir"

  CURRENT_STEP="module 5 execution"
  mkdir -p "$outdir"
  (
    cd "$outdir"
    local -a cmd=(Rscript "$SCRIPT_DIR/5_cross_condition_correlation.R" \
	      --DEG "$deg_file" \
