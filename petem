#!/usr/bin/env bash
set -euo pipefail

MODULE_NAME="PeTEM CLI"
SCRIPT_NAME=$(basename "${BASH_SOURCE[0]}")
CURRENT_STEP="initialization"
PETEM_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SCRIPT_DIR="$PETEM_ROOT/scripts"

die() {
  echo "[ERROR] ${MODULE_NAME} | ${SCRIPT_NAME} | ${CURRENT_STEP}: $*" >&2
  exit 1
}

