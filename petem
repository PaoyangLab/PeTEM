run_module_3() {
  local gene_input=""
  local gene_bed=""
  local te_bed=""
  local overlap_bed=""
  local gene_exp=""
  local te_exp=""
  local fai=""
  local outdir=""
  local manifest=""
  local limit=4000
  local tick=0
  local percentile=10
  local window_size=100
  local line_mode="raw"
  local show_ci="n"
  local show_border="n"
  local unexp="y"
  local control="y"
  local -a meth_files=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -g) gene_input=$2; shift 2 ;;
      -t) te_bed=$2; shift 2 ;;
      -i) overlap_bed=$2; shift 2 ;;
      -eg) gene_exp=$2; shift 2 ;;
      -et) te_exp=$2; shift 2 ;;
      -f) fai=$2; shift 2 ;;
      --manifest) manifest=$2; shift 2 ;;
      -o) outdir=$2; shift 2 ;;
      -d|-lim) limit=$2; shift 2 ;;
      -tick) tick=$2; shift 2 ;;
      -p) percentile=$2; shift 2 ;;
      -w|-WD) window_size=$2; shift 2 ;;
      -l) line_mode=$2; shift 2 ;;
      -CI) show_ci=$2; shift 2 ;;
      -border) show_border=$2; shift 2 ;;
      -unexp) unexp=$2; shift 2 ;;
      -nTE) control=$2; shift 2 ;;
      -m)
        shift
        while [[ $# -gt 0 && ! $1 =~ ^- ]]; do
          meth_files+=("$1")
          shift
        done
        ;;
      -h|--help) usage ;;
      *) die "unknown option for module 3: $1" ;;
    esac
  done

  CURRENT_STEP="argument validation"
  if [[ -n $manifest ]]; then
    manifest=$(resolve_path "$manifest")
    require_file "module 0 manifest file" "$manifest"
    [[ -n $gene_input ]] || gene_input=$(manifest_get "$manifest" "outputs.annotation_dir" || true)
    [[ -n $te_bed ]] || te_bed=$(manifest_get "$manifest" "inputs.te_bed_prepared" || true)
    [[ -n $te_bed ]] || te_bed=$(manifest_get "$manifest" "inputs.te_input_original" || true)
    [[ -n $overlap_bed ]] || overlap_bed=$(manifest_get "$manifest" "outputs.te_overlap_promoter_bed" || true)
    [[ -n $gene_exp ]] || gene_exp=$(manifest_get "$manifest" "inputs.gene_expression" || true)
    [[ -n $te_exp ]] || te_exp=$(manifest_get "$manifest" "inputs.te_expression" || true)
    [[ -n $fai ]] || fai=$(manifest_get "$manifest" "inputs.fai" || true)
    if (( ${#meth_files[@]} == 0 )); then
      mapfile -t meth_files < <(manifest_get_array "$manifest" "inputs.methylation_files" || true)
    fi
  fi

  [[ -n $gene_input ]] || die "missing required argument: -g gene.bed_or_genome_bed_dir or --manifest module0_manifest.json"
  [[ -n $te_bed ]] || die "missing required argument: -t TE.bed_or_TE.txt or --manifest module0_manifest.json"
  [[ -n $overlap_bed ]] || die "missing required argument: -i TE_overlap_promoter.bed or --manifest module0_manifest.json"
  [[ -n $gene_exp ]] || die "missing required argument: -eg gene_expression.txt or --manifest module0_manifest.json"
  [[ -n $te_exp ]] || die "missing required argument: -et TE_expression.txt or --manifest module0_manifest.json"
  gene_input=$(resolve_path "$gene_input")
  te_bed=$(resolve_path "$te_bed")
  overlap_bed=$(resolve_path "$overlap_bed")
  gene_exp=$(resolve_path "$gene_exp")
  te_exp=$(resolve_path "$te_exp")
  [[ -z $fai ]] || fai=$(resolve_path "$fai")
  outdir=$(resolve_path "${outdir:-$(pwd)}")

  if [[ -d $gene_input ]]; then
    gene_bed="$gene_input/gene.bed"
  else
    gene_bed="$gene_input"
  fi

  require_file "gene BED file" "$gene_bed"
  require_file "TE input file" "$te_bed"
  require_file "TE overlap promoter BED file" "$overlap_bed"
  require_file "Gene expression file" "$gene_exp"
  require_file "TE expression file" "$te_exp"
  [[ -z $fai ]] || require_file "FAI file" "$fai"

  local i
  for ((i = 0; i < ${#meth_files[@]}; i++)); do
    meth_files[$i]=$(resolve_path "${meth_files[$i]}")
    require_file "Methylation file" "${meth_files[$i]}"
  done

  CURRENT_STEP="module 3 execution"
  mkdir -p "$outdir"
  local -a module3_meth_args=()
  if (( ${#meth_files[@]} > 0 )); then
    module3_meth_args=(-m "${meth_files[@]}")
  fi
  te_bed=$(prepare_te_bed "$te_bed" "$outdir/tmp/module_3_te_input")
  CURRENT_STEP="seqname normalization"
  local normalize_reference="$gene_bed"
  local normalize_reference_kind="bed"
  if [[ -n $fai ]]; then
    normalize_reference="$fai"
    normalize_reference_kind="fai"
  fi
  local normalized_output
  normalized_output=$(
    normalize_seqname_files "$normalize_reference" "$normalize_reference_kind" "$outdir/tmp/module_3_normalized" \
      "${te_bed}::bed"
  )
  mapfile -t normalized_paths <<< "$normalized_output"
  for item in "${normalized_paths[@]}"; do
    mapped_src=${item%%$'\t'*}
    mapped_dst=${item#*$'\t'}
    if [[ $mapped_src == "$te_bed" ]]; then
      te_bed=$mapped_dst
    fi
  done
  (
    cd "$outdir"
    bash "$SCRIPT_DIR/3_TE_impact_distance.sh" \
      "${module3_meth_args[@]}" \
      -g "$gene_bed" \
      -t "$te_bed" \
      -i "$overlap_bed" \
      -eg "$gene_exp" \
      -et "$te_exp" \
      -lim "$limit" \
      -tick "$tick" \
      -p "$percentile" \
      -w "$window_size" \
      -l "$line_mode" \
      -CI "$show_ci" \
      -border "$show_border" \
      -unexp "$unexp" \
      -nTE "$control"
  )
}

