  cat >&2 <<'EOF'
Usage:
  petem --0 -g annotation.gff3 -t TE.bed_or_TE.txt -eg gene_expression.txt -et TE_expression.txt [-DEG DEG.txt -DETE DETE.txt] -f genome.fa.fai -m sample1.CGmap.gz [sample2.CGmap.gz ...] [-o output_dir]
  petem 0_preprocessing -g annotation.gff3 -t TE.bed_or_TE.txt -eg gene_expression.txt -et TE_expression.txt [-DEG DEG.txt -DETE DETE.txt] -f genome.fa.fai -m sample1.CGmap.gz [sample2.CGmap.gz ...] [-o output_dir]
  petem --1 [-g genome_bed_dir] [-t TE.bed_or_TE.txt] [-f genome.fa.fai] [--manifest module0_manifest.json] [-o output_dir]
  petem 1_TE_distribution [-g genome_bed_dir] [-t TE.bed_or_TE.txt] [-f genome.fa.fai] [--manifest module0_manifest.json] [-o output_dir]
  petem --2 [-t TE.bed_or_TE.txt] [-T TE_family.txt] [-i TE_overlap_promoter.bed] [--manifest module0_manifest.json] [-o output_dir]
  petem 2_TE_families [-t TE.bed_or_TE.txt] [-T TE_family.txt] [-i TE_overlap_promoter.bed] [--manifest module0_manifest.json] [-o output_dir]
  petem --3 [-g gene.bed_or_genome_bed_dir] [-t TE.bed_or_TE.txt] [-i TE_overlap_promoter.bed] [-eg gene_expression.txt] [-et TE_expression.txt] [-f genome.fa.fai] [-m sample1.CGmap.gz [sample2.CGmap.gz ...]] [--manifest module0_manifest.json] [-o output_dir] [-d 4000] [-tick auto] [-p 10] [-w 100] [-l raw|linear|poly|loess] [-CI y|n] [-border y|n] [-unexp y|n] [-nTE y|n]
  petem 3_TE_impact_distance [-g gene.bed_or_genome_bed_dir] [-t TE.bed_or_TE.txt] [-i TE_overlap_promoter.bed] [-eg gene_expression.txt] [-et TE_expression.txt] [-f genome.fa.fai] [-m sample1.CGmap.gz [sample2.CGmap.gz ...]] [--manifest module0_manifest.json] [-o output_dir] [-d 4000] [-tick auto] [-p 10] [-w 100] [-l raw|linear|poly|loess] [-CI y|n] [-border y|n] [-unexp y|n] [-nTE y|n]
  petem --4 [-eg gene_expression.txt] [-et TE_expression.txt] [--module0-dir module0_output_dir] [--manifest module0_manifest.json] [-o output_dir] [--unexp y|n]  [--smooth 3]
  petem 4_single_condition_correlation [-eg gene_expression.txt] [-et TE_expression.txt] [--module0-dir module0_output_dir] [--manifest module0_manifest.json] [-o output_dir] [--unexp y|n]  [--smooth 3]
  petem --5 [--module0-dir module0_output_dir] [--manifest module0_manifest.json] [-o output_dir] [--unexp y|n] [-stage A B] [--positive y|n]
  petem 5_cross_condition_correlation [--module0-dir module0_output_dir] [--manifest module0_manifest.json] [-o output_dir] [--unexp y|n] [-stage A B] [--positive y|n]

Required files inside genome_bed_dir:
  gene.bed
  CDS.bed
  exon.bed
  UTR5.bed
  UTR3.bed
  promoter.bed
EOF
  exit 1
}

require_file() {
  local label=$1
  local path=$2
  [[ -f $path ]] || die "${label} not found: ${path}"
}

resolve_path() {
  python3 - "$1" <<'PYTHON_HELPER'
import os
import sys
print(os.path.abspath(os.path.expanduser(sys.argv[1])))
PYTHON_HELPER
}

manifest_get() {
  local manifest=$1
  local key=$2
  python3 - "$manifest" "$key" <<'PYTHON_HELPER'
import json
import sys

manifest_path, key = sys.argv[1:3]
with open(manifest_path, "r", encoding="utf-8") as handle:
    data = json.load(handle)

value = data
for part in key.split("."):
    if not isinstance(value, dict) or part not in value:
        sys.exit(1)
    value = value[part]

if value is None:
    sys.exit(1)
if isinstance(value, (dict, list)):
    print(json.dumps(value))
else:
    print(value)
PYTHON_HELPER
}

manifest_get_array() {
  local manifest=$1
  local key=$2
  python3 - "$manifest" "$key" <<'PYTHON_HELPER'
import json
import sys

manifest_path, key = sys.argv[1:3]
with open(manifest_path, "r", encoding="utf-8") as handle:
    data = json.load(handle)

value = data
for part in key.split("."):
    if not isinstance(value, dict) or part not in value:
        sys.exit(1)
    value = value[part]

if not isinstance(value, list):
    sys.exit(1)

for item in value:
    print(item)
PYTHON_HELPER
}

