      -o) outdir=$2; shift 2 ;;
      --unexp) unexp=$2; shift 2 ;;
      --positive) positive=$2; shift 2 ;;
      -stage|--stage) [[ $# -ge 3 ]] || die "-stage requires two values"; stage_a=$2; stage_b=$3; shift 3 ;;
      -h|--help) usage ;;
      *) die "unknown option for module 5: $1" ;;
    esac
  done

  CURRENT_STEP="argument validation"
  if [[ -n $manifest ]]; then
    manifest=$(resolve_path "$manifest")
    require_file "module 0 manifest file" "$manifest"
    [[ -n $module0_dir ]] || module0_dir=$(manifest_get "$manifest" "module0_output_dir" || true)
