    [[ -n $dete_file ]] || dete_file=$(manifest_get "$manifest" "outputs.dete_file" || true)
  fi

  [[ -n $module0_dir ]] || die "missing required argument: --module0-dir module0_output_dir or --manifest module0_manifest.json"
  [[ -n $deg_file ]] || deg_file="$module0_dir/DEG.txt"
  [[ -n $dete_file ]] || dete_file="$module0_dir/DETE.txt"

